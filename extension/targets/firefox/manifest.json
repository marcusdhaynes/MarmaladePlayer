{
  "manifest_version": 3,
  "name": "Marmalade Library",
  "version": "0.2.0",
  "description": "Independent Marmaladeum media library backup for Firefox; metadata persists, file reopening respects Firefox permissions.",
  "browser_specific_settings": {
    "gecko": {
      "id": "marmalade-library@somniel.com",
      "strict_min_version": "128.0"
    }
  },
  "action": {
    "default_title": "Marmalade Library"
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "options_ui": {
    "page": "library.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "matches": [
        "https://marmaladeum.com/*",
        "https://www.marmaladeum.com/*",
        "https://marcusdhaynes.github.io/MarmaladePlayer/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ]
    }
  ]
}
