{
  "action": {
    "default_title": "Marmalade Library"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://marmaladeum.com/*",
        "https://www.marmaladeum.com/*",
        "https://marcusdhaynes.github.io/MarmaladePlayer/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "description": "Independent persistent Marmaladeum media library catalog; optional remembered Chromium folder access.",
  "manifest_version": 3,
  "name": "Marmalade Library",
  "options_page": "library.html",
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "version": "0.2.0"
}
